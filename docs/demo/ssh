#!/bin/bash
# Stands in for ssh in the demo recording: "connects" to made-up hosts by
# starting demo_agent or a shell here. See docs/demo/README.md.
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
    [ "${args[i]}" = "-O" ] && exit 0
    if [ "${args[i]}" = "--" ]; then
        alias="${args[i + 1]}"
        remote="${args[i + 2]}"
    fi
done
case "$remote" in
    *uname*) echo "Linux $(uname -m)" ;;
    *"agent --stdio"*) exec "$DEMO_AGENT" "$alias" ;;
    *)
        # A terminal: the host's nerdmux, from its own home.
        export HOME="$DEMO_WORK/hosts/$alias"
        export NERDMUX_SOCKET="$HOME/sock"
        export NERDMUX_CONFIG="$HOME/config.toml"
        cd "$HOME/runs" && exec nerdmux
        ;;
esac
